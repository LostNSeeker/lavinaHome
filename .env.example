# LEVINA HOME Integration Configuration

# -----------------------------------------------------------------------------
# Shopify Storefront & Admin API Credentials
# -----------------------------------------------------------------------------
# Domain of your Shopify store (e.g. levinahome.myshopify.com)
SHOPIFY_STORE_DOMAIN=levinahome.myshopify.com

# Shopify Storefront API Public Token (For GraphQL Catalog & Cart API)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=shpat_mock_storefront_token_12345

# Shopify Admin API Token (Server-side admin operations)
SHOPIFY_ADMIN_API_TOKEN=shpat_mock_admin_token_67890

# Shopify API Version (Default: 2024-01)
SHOPIFY_API_VERSION=2024-01


# -----------------------------------------------------------------------------
# PlentyONE (Plentymarkets) REST API Credentials
# -----------------------------------------------------------------------------
# PlentyONE System ID / PID
PLENTYONE_ID=123456

# PlentyONE API Host Domain
PLENTYONE_HOST=https://p123456.my.plentysystems.com

# PlentyONE API User Credentials (OAuth2 Password Grant)
PLENTYONE_USERNAME=api_user
PLENTYONE_PASSWORD=secure_api_password

# Sync Settings
PLENTYONE_SYNC_INTERVAL_MINUTES=15
ENABLE_PLENTYONE_LIVE_STOCK=true

# -----------------------------------------------------------------------------
# SMTP Email & Invoicing Configuration
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=service@levinahome.com
SMTP_PASS=your_smtp_password
SMTP_FROM="LEVINA HOME Service <service@levinahome.com>"
COMPANY_NAME=LEVINA HOME (Böing Carpet GmbH)
COMPANY_ADDRESS=Industriestr. 23, 48249 Dülmen, Germany
COMPANY_EMAIL=service@levinahome.com

